# Required environment for atla.design v2. Values empty on purpose; set them in Vercel (Production and Preview).
# ANTHROPIC_API_KEY is not used anywhere: the brief and the work search call no AI service.

# Contact form and brief: written to Attio (person + note). Without it POST /api/contact answers 503.
ATTIO_API_KEY=

# Brief email to the studio (Resend). BRIEF_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
BRIEF_FROM_EMAIL=
# Optional: defaults to josepablo@atla.design
BRIEF_TO_EMAIL=

# Booking link shown after the brief (https URL). The visitor's name and email are appended as parameters.
CALENDLY_URL=

# Shared rate limits and brief idempotency (Upstash Redis REST). Without them counters live per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32+ random bytes. Keys the hash of visitor addresses in the rate-limit counters.
RATE_LIMIT_SALT=

# Sanity content (projects and journal).
SANITY_JOURNAL_PROJECT_ID=
SANITY_JOURNAL_DATASET=production
SANITY_JOURNAL_API_VERSION=2026-03-12
SANITY_JOURNAL_READ_TOKEN=
# Projects whose Sanity status is Draft are public today. Set to false to leave them out of the API,
# the wall, the sitemap and the prerender (build time and runtime).
SANITY_INCLUDE_DRAFTS=

# Build-time ids for the consent-gated tags (baked in at build). Empty means the tag never loads.
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=
