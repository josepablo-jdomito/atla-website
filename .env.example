DATABASE_URL=postgres://user:password@localhost:5432/atla

# Admin route protection
ADMIN_ACCESS_PASSWORD=change-me

# Separate Sanity journal content source.
# Used both by the runtime API and by the Vercel build step that prerenders journal SEO pages.
SANITY_JOURNAL_PROJECT_ID=your-project-id
SANITY_JOURNAL_DATASET=production
SANITY_JOURNAL_API_VERSION=2026-03-12
SANITY_JOURNAL_READ_TOKEN=

# Contact form delivery. Inquiries from /contact are written to Attio (person + note).
# Without it, POST /api/contact answers 503 and the page falls back to the public email.
ATTIO_API_KEY=

# The Mirror, the live cold read on love.atla.design (POST /api/brand-read).
# Without BOTH keys the endpoint answers 503 and the page says the live read is
# not switched on yet. Each uncached read costs a Firecrawl search plus two or
# three scrapes, and one Claude call; reads are cached per brand for 24h and
# rate limited to 5 per hour per IP.
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
